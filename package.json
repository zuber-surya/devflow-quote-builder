    "@auth/prisma-adapter": "^2.0.0",
    "@hookform/resolvers": "^5.8.0",
    "react-hook-form": "^7.85.0",
    "zod": "^3.25.0",
    "axios": "^1.6.0",
    "pdfkit": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "tailwindcss": "^3.4.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
