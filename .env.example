# ============================================================================
# QUOTE & INVOICE BUILDER - ENVIRONMENT VARIABLES
# Copy this file to .env.local and configure for your environment
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Format: postgresql://user:password@host:port/database
# For Docker: postgresql://postgres:postgres@localhost:5432/quote_invoice_builder_dev
# For local PostgreSQL: postgresql://youruser:yourpassword@localhost:5432/quote_invoice_builder_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quote_invoice_builder_dev"

# ============================================================================
# AUTHENTICATION - NextAuth.js (Web)
# ============================================================================
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" for verbose auth debugging (development only)
NEXTAUTH_DEBUG="false"

# ============================================================================
# AUTHENTICATION - JWT (Mobile/Flutter)
# ============================================================================
# Generate secret with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key-change-this-in-production"
# Token expiry (short-lived for security)
JWT_EXPIRY="7d"
# Refresh token expiry (longer-lived, used to get new JWT)
REFRESH_TOKEN_EXPIRY="30d"

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Public API URL (used by client-side code)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Directory for business logos and uploads
UPLOAD_DIR="./public/business-logos"
# Maximum file size in bytes (5MB)
MAX_UPLOAD_SIZE="5242880"
# Allowed MIME types
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# ============================================================================
# PDF GENERATION CONFIGURATION
# ============================================================================
# Temporary directory for generated PDFs
PDF_TEMP_DIR="./tmp/pdfs"
# How long to keep PDFs in temp before auto-delete (in hours)
PDF_RETENTION_HOURS="24"

# ============================================================================
# EMAIL CONFIGURATION (Optional - for future notifications)
# ============================================================================
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-password"
# SMTP_FROM="noreply@example.com"
# SMTP_TLS="true"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
# Set to "true" to log all SQL queries (development only, verbose)
LOG_SQL="false"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV="development"
APP_NAME="Quote & Invoice Builder"
APP_VERSION="0.1.0"

# ============================================================================
# FEATURE FLAGS (toggle features on/off)
# ============================================================================
FEATURE_PDF_EXPORT="true"
FEATURE_BULK_OPERATIONS="false"
FEATURE_EMAIL_NOTIFICATIONS="false"
FEATURE_PAYMENT_INTEGRATION="false"

# ============================================================================
# TIMEZONE
# ============================================================================
TZ="UTC"

# ============================================================================
# NOTES FOR SETUP
# ============================================================================
# 1. Copy this file to .env.local (will be gitignored)
# 2. Update DATABASE_URL with your PostgreSQL connection details
# 3. Generate secure secrets:
#    openssl rand -base64 32
# 4. For production, never commit .env.local to git
# 5. Use strong, random values for all secrets
# ============================================================================
