# Claude Code local tool/plugin data (not project code) - but keep project-authored
# agents/skills, which ARE meant to be committed and shared. List each skill
# explicitly rather than un-ignoring .claude/skills/ wholesale, so installed
# plugin skill caches (e.g. ui-ux-pro-max) never get swept back in.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md
!.claude/skills/
.claude/skills/*
!.claude/skills/implement-feature/
!.claude/skills/db-change-workflow/

# Dependencies
node_modules/
/.pnp
.pnp.js
pnpm-lock.yaml
yarn.lock
package-lock.json

# Testing
/coverage
.nyc_output

# Production
/build
/.next
/out
dist/

# Misc
.DS_Store
*.pem
.env
.env.local
.env.*.local
.env.production.local
.env.test.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# OS
Thumbs.db
.AppleDouble
.LSOverride

# Temporary files
tmp/
temp/
*.tmp
.cache/

# Database
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite3

# PDF temp files (but keep directory)
tmp/pdfs/*
!tmp/pdfs/.gitkeep

# Build artifacts
*.tsbuildinfo

# Environment-specific
.env.local
.env.*.local
